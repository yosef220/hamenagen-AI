{
  "name": "hamenagen",
  "productName": "המנגן",
  "version": "1.0.0",
  "description": "המנגן — נגן מוזיקה קהילתי חכם: מבין בקשות בעברית, מכיר את הלוח העברי ועובד בלי אינטרנט",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor.js",
    "vendor": "node scripts/copy-vendor.js",
    "dist": "electron-builder --win",
    "prepare:win-python": "powershell -ExecutionPolicy Bypass -File scripts/prepare-win-python.ps1",
    "build:win": "npm run prepare:win-python && npm run dist",
    "test:core": "cd backend && python -m pytest -q"
  },
  "author": "hamenagen",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "@fontsource/frank-ruhl-libre": "5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "electron": "44.10.0",
    "electron-builder": "26.18.1",
    "lucide-static": "1.62.0"
  },
  "build": {
    "appId": "org.community.hamenagen",
    "productName": "המנגן",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!tests/**",
          "!data/**"
        ]
      },
      {
        "from": "build/win-python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "hamenagen-${version}.${ext}"
    },
    "portable": {
      "artifactName": "hamenagen-portable-${version}.exe"
    }
  }
}
